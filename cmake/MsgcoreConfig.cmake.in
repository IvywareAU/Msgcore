#
# MsgcoreConfig.cmake - what find_package(Msgcore) loads.
#
# It declares ONE imported target, Msgcore::msgcore, carrying the installed
# library and <prefix>/include. It declares no dependencies, because the
# installed Msgcore has none a consumer must satisfy: p2pplatform is a
# build-time include-path shim that is deliberately absent from the export
# (see the $<BUILD_INTERFACE:> note in Msgcore/CMakeLists.txt), and the
# platform libraries the DLL/.so links are recorded in the binary itself.
@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/MsgcoreTargets.cmake")

check_required_components(Msgcore)
