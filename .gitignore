# Single build output root: out\<Platform>\<Configuration>\ (binaries) and
# out\<Platform>\<Configuration>\obj\ (intermediates), pinned in the vcxproj.
# The old split -- Debug\ and Release\ for Win32, x64\<Config>\ plus a stray
# Msgcore\<Platform>\<Config>\ for x64 -- is no longer produced.
out/
/.vs/Msgcore(2022)/FileContentIndex/7c51bab5-36a2-4afa-bfad-195a1f925948.vsidx
/.vs/Msgcore(2022)/v17/Browse.VC.db
/.vs/Msgcore(2022)/v17/Browse.VC.db-shm
/.vs/Msgcore(2022)/v17/Browse.VC.db-wal
/.vs/Msgcore(2022)/v17/Browse.VC.opendb
/Msgcore(2014).def
/Msgcore(2014).vcproj
/Msgcore(2015).vcxproj
/Msgcore(2015).vcxproj.filters
/Msgcore(2015).vcxproj.user
/Msgcore(2017).vcxproj
/Msgcore(2017).vcxproj.filters
/Msgcore(2017).vcxproj.user
/Msgcore(2019).vcxproj
/Msgcore(2019).vcxproj.filters
/Msgcore(2019).vcxproj.user

# CMake configure/build trees. CMakeLists.txt configures standalone now, so these
# get created in the repository root rather than only in the parent tree.
/build/
/build-*/
CMakeCache.txt
CMakeFiles/

# Import-library staging. Directory.Build.props defaults $(WDMSCS_LIB) to this
# directory in a standalone clone; inside the MSCS tree it stays at MSCS\lib\.
/lib/

# IDE / tooling caches
.vs/
.understand-anything/
# Per-user project settings, wherever the project lives -- com\ has one too
*.vcxproj.user
# Visual Studio resource-editor binary cache. Regenerated from the .rc on
# demand, differs per machine, and goes stale the moment the .rc is edited by
# hand -- which Msgcore.rc now is, for the VERSIONINFO block.
*.aps

# The release-readiness register is deliberately not in this repository.
# It was withheld and now lives outside the tree; do not add it back.
RELEASE_READINESS.md
