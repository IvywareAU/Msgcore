  <!-- =====================================================================
       DebugLib / ReleaseLib: static-library variants of the same sources.

       _AFXEXT is deliberately absent from these four configurations (it is set
       on the four DLL configurations above). _AFXEXT declares an MFC *extension
       DLL*; an archive is not a module, has no DllMain and joins no
       CDynLinkLibrary resource chain, so setting it here decorated MFC's own
       AFX_EXT_CLASS dllexport in a target that exports nothing. It was harmless
       only because Msgcore's own linkage keys off Msgcore_STATIC (Msgcore.h),
       never off AFX_EXT_CLASS.

       UseOfMfc stays Dynamic and RuntimeLibrary stays /MD: the archive must be
       compiled against exactly the MFC and CRT the consumer absorbing it uses.

       The archive is written to $(OutDir) (which is also $(TargetPath), so
       MSBuild's up-to-date check stays honest) and the PostBuildEvent stages a
       copy into $(WDMSCS_LIB) = lib\<Platform>\<Configuration>, alongside where
       the DLL configurations put their import library. The Lib tool has no
       <ImportLibrary> equivalent, which is why the copy has to be explicit; this
       is what left lib\x64\DebugLib and lib\x64\ReleaseLib created-but-empty
       (Directory.Build.targets' EnsureWDMSCSLibDir makes the directory before
       Lib runs, but nothing ever wrote into it). It runs on every build, so the
       staged copy cannot lag the one in out\.
       ===================================================================== -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='DebugLib|Win32'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>WIN32;_WINDOWS;_DEBUG;Msgcore_STATIC;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <BasicRuntimeChecks>EnableFastChecks</BasicRuntimeChecks>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <RuntimeTypeInfo>true</RuntimeTypeInfo>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <WarningLevel>Level4</WarningLevel>
      <DebugInformationFormat>EditAndContinue</DebugInformationFormat>
      <BrowseInformation>true</BrowseInformation>
      <SDLCheck>true</SDLCheck>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
    </ClCompile>
    <Lib>
      <OutputFile>$(OutDir)$(TargetName).lib</OutputFile>
    </Lib>
    <PostBuildEvent>
      <Command>if not exist "$(WDMSCS_LIB)" mkdir "$(WDMSCS_LIB)"
copy /Y "$(OutDir)$(TargetName).lib" "$(WDMSCS_LIB)\$(TargetName).lib"</Command>
      <Message>Staging static $(TargetName).lib to $(WDMSCS_LIB)</Message>
    </PostBuildEvent>
    <ProjectReference>
      <UseLibraryDependencyInputs>false</UseLibraryDependencyInputs>
    </ProjectReference>
    <Bscmake>
      <PreserveSbr>true</PreserveSbr>
    </Bscmake>
  </ItemDefinitionGroup>
